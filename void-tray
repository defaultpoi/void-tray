#!/usr/bin/env python3
"""Starts void-tray from a checkout. Symlink this file into ~/.local/bin:
    ln -sf ~/projects/void-tray/void-tray ~/.local/bin/void-tray
It resolves the link, so `git pull` is all an update needs."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from void_tray.app import main  # noqa: E402

main()
